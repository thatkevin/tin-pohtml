<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
      /* Email styles */
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        line-height: 1.6;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        text-align: center;
        padding: 20px 0;
        border-bottom: 1px solid #ddd;
      }
      .content {
        padding: 20px 0;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #d85b61;
        color: white !important;
        text-decoration: none;
        border-radius: 4px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        color: #999;
        font-size: 12px;
        border-top: 1px solid #ddd;
        padding-top: 20px;
      }
      a {
        color: #0b8793;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>The Tin Music and Arts</h1>
      </div>
      
      <div class="content">
        <%= yield %>
      </div>
      
      <div class="footer">
        <p>The Tin Music and Arts | Units 1 - 4, The Canal Basin, CV1 4LY</p>
        <p>Tel: 02476 230 699 | Registered Charity No.: 1152636</p>
      </div>
    </div>
  </body>
</html>