<% content_for :title, @gig.title %>

<div class="mb-6">
  <div class="flex justify-between items-center">
    <div class="flex items-center">
      <%= link_to admin_gigs_path, class: "mr-2 text-gray-500 hover:text-gray-700" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <h1 class="text-2xl font-semibold text-gray-800">Gig Details</h1>
    </div>
    <div>
      <%= link_to edit_admin_gig_path(@gig), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded inline-flex items-center mr-2" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
        </svg>
        <span>Edit</span>
      <% end %>
      <%= link_to admin_gig_path(@gig), method: :delete, data: { confirm: "Are you sure you want to delete this gig?" }, class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded inline-flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        <span>Delete</span>
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <!-- Basic Information -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Gig Information</h2>
      
      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-medium text-gray-500">Title</h3>
          <p class="mt-1 text-sm text-gray-900"><%= @gig.title %></p>
        </div>
        
        <% if @gig.headline.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Headline</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @gig.headline %></p>
          </div>
        <% end %>
        
        <% if @gig.subheadline.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Subheadline</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @gig.subheadline %></p>
          </div>
        <% end %>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500">Date & Time</h3>
          <p class="mt-1 text-sm text-gray-900">
            <%= @gig.date.strftime("%A, %d %B %Y") %>
            <% if @gig.start_time %>
              at <%= @gig.formatted_time %>
            <% end %>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500">Price</h3>
          <p class="mt-1 text-sm text-gray-900"><%= @gig.formatted_price %></p>
        </div>
        
        <% if @gig.series %>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Series</h3>
            <p class="mt-1 text-sm text-gray-900">
              <%= link_to @gig.series.name, admin_series_path(@gig.series), class: "text-indigo-600 hover:text-indigo-900" %>
            </p>
          </div>
        <% end %>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500">Status</h3>
          <p class="mt-1 text-sm">
            <% if @gig.published %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                Published
              </span>
            <% else %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                Draft
              </span>
            <% end %>
          </p>
        </div>
      </div>
    </div>
    
    <!-- Description -->
    <% if @gig.description.present? %>
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Description</h2>
        <div class="prose max-w-none">
          <%= simple_format @gig.description %>
        </div>
      </div>
    <% end %>
  </div>
  
  <div class="space-y-6">
    <!-- Images -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Images</h2>
      
      <div class="space-y-4">
        <% if @gig.main_image.attached? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-2">Main Image</h3>
            <%= image_tag @gig.main_image, class: "w-full h-auto rounded" %>
          </div>
        <% end %>
        
        <% if @gig.thumbnail_image.attached? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-2">Thumbnail</h3>
            <%= image_tag @gig.thumbnail_image, class: "w-1/2 h-auto rounded" %>
          </div>
        <% end %>
        
        <% if @gig.banner_image.attached? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-2">Banner</h3>
            <%= image_tag @gig.banner_image, class: "w-full h-auto rounded" %>
          </div>
        <% end %>
        
        <% if !@gig.main_image.attached? && !@gig.thumbnail_image.attached? && !@gig.banner_image.attached? %>
          <p class="text-sm text-gray-500">No images uploaded yet.</p>
          <%= link_to "Add images", edit_admin_gig_path(@gig), class: "text-indigo-600 hover:text-indigo-900" %>
        <% end %>
      </div>
    </div>
    
    <!-- External Links -->
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Links & URLs</h2>
      
      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-medium text-gray-500">Event URL</h3>
          <p class="mt-1 text-sm text-gray-900">
            <% if @gig.slug.present? %>
              <a href="/gigs/<%= @gig.slug %>" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                /gigs/<%= @gig.slug %>
                <svg class="w-4 h-4 inline-block ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            <% else %>
              <span class="text-gray-500">Not set</span>
            <% end %>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500">Ticket URL</h3>
          <p class="mt-1 text-sm text-gray-900">
            <% if @gig.ticket_url.present? %>
              <a href="<%= @gig.full_ticket_url %>" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                <%= @gig.ticket_url %>
                <svg class="w-4 h-4 inline-block ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            <% else %>
              <span class="text-gray-500">Not set</span>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>