<%= form_with(model: [:admin, gig], local: true, class: "space-y-6") do |form| %>
  <% if gig.errors.any? %>
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4">
      <h2 class="font-bold mb-2">
        <%= pluralize(gig.errors.count, "error") %> prevented this gig from being saved:
      </h2>
      <ul class="list-disc ml-5">
        <% gig.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-md space-y-6">
    <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">Basic Information</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :title, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
      
      <div>
        <%= form.label :slug, "URL Slug", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :slug, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", placeholder: "generated-from-title" %>
        <p class="mt-1 text-sm text-gray-500">Leave blank to auto-generate from title</p>
      </div>
      
      <div>
        <%= form.label :headline, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :headline, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Short tagline or presenter name</p>
      </div>
      
      <div>
        <%= form.label :subheadline, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :subheadline, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Quote or additional info</p>
      </div>
    </div>
    
    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :description, rows: 5, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
    </div>
    
    <div>
      <%= form.label :series_id, "Series (Optional)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.collection_select :series_id, Series.all.order(:name), :id, :name, {include_blank: "None"}, class: "mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-md space-y-6">
    <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">Date & Time</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <%= form.label :date, class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :date, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
      
      <div>
        <%= form.label :start_time, class: "block text-sm font-medium text-gray-700" %>
        <%= form.time_field :start_time, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
      </div>
      
      <div>
        <%= form.label :end_time, class: "block text-sm font-medium text-gray-700" %>
        <%= form.time_field :end_time, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Optional</p>
      </div>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-md space-y-6">
    <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">Ticketing</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :price, class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1 relative rounded-md shadow-sm">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-gray-500 sm:text-sm">£</span>
          </div>
          <%= form.number_field :price, min: 0, step: 0.01, class: "focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-7 pr-12 sm:text-sm border-gray-300 rounded-md" %>
        </div>
      </div>
      
      <div>
        <%= form.label :ticket_url, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :ticket_url, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", placeholder: "https://..." %>
      </div>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-md space-y-6">
    <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">Images</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <%= form.label :main_image, class: "block text-sm font-medium text-gray-700" %>
        <%= form.file_field :main_image, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Large feature image (16:9)</p>
      </div>
      
      <div>
        <%= form.label :thumbnail_image, class: "block text-sm font-medium text-gray-700" %>
        <%= form.file_field :thumbnail_image, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Small thumbnail (1:1)</p>
      </div>
      
      <div>
        <%= form.label :banner_image, class: "block text-sm font-medium text-gray-700" %>
        <%= form.file_field :banner_image, class: "mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" %>
        <p class="mt-1 text-sm text-gray-500">Wide banner image (21:9)</p>
      </div>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-md">
    <div class="flex items-start">
      <div class="flex items-center h-5">
        <%= form.check_box :published, class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
      </div>
      <div class="ml-3 text-sm">
        <%= form.label :published, class: "font-medium text-gray-700" %>
        <p class="text-gray-500">Show this gig on the public website</p>
      </div>
    </div>
  </div>

  <div class="flex justify-end">
    <%= link_to "Cancel", admin_gigs_path, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-2" %>
    <%= form.submit class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>